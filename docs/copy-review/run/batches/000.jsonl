{"id": "lib/l10n/app_en.arb:alarmWakeTimeRowTitle", "file": "lib/l10n/app_en.arb", "location": "alarmWakeTimeRowTitle", "text": "Wake time", "sha256": "27b9aac0c836596291987eab6948d15e417867b4ff1a863863878ee90800127c", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:alarmNotConnectedTitle", "file": "lib/l10n/app_en.arb", "location": "alarmNotConnectedTitle", "text": "The band is not connected", "sha256": "9d953e43e8ead45858125a4ffd50ed66c9f08e2a16b73c29ea91b204b086bda4", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:alarmNotConnectedBody", "file": "lib/l10n/app_en.arb", "location": "alarmNotConnectedBody", "text": "Changing the schedule, testing and cancelling all write to the band, so they need a live connection. An alarm that is already armed is unaffected — it lives on the band.", "sha256": "a2eb28d0e09d060e5ef0e309b1e964eae6bc9e0913c28cd221d8ab774acc6b95", "kind": "arb"}
