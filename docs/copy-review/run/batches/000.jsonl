{"id": "lib/l10n/app_en.arb:pairingSkipForNow", "file": "lib/l10n/app_en.arb", "location": "pairingSkipForNow", "text": "Skip for now", "sha256": "b58eb52c8810b97857e264ea9de45f7bd7edb754bb0edad30ffab78ff027c45e", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingSkipNote", "file": "lib/l10n/app_en.arb", "location": "pairingSkipNote", "text": "The app opens without a band. Nothing is measured until one is paired.", "sha256": "b6b785170c33aceb11c167c9cd20cecc526086bce0edc0ba83599bf5fb3b53bb", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingIdleTitle", "file": "lib/l10n/app_en.arb", "location": "pairingIdleTitle", "text": "Wake the band and hold it close", "sha256": "30ce0253a940ed57d6999d4effc99c5bc0d16db9fbb42e5fd86722606c4ce3d3", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingIdleBody", "file": "lib/l10n/app_en.arb", "location": "pairingIdleBody", "text": "Take the band off the charger, put it on your wrist and keep the phone within arm’s reach.", "sha256": "a25d15f0d53c29da5717fff548f29799cda5bec2810183e77aa6be80914c8610", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingScanningTitle", "file": "lib/l10n/app_en.arb", "location": "pairingScanningTitle", "text": "Looking for your band", "sha256": "2bf11fa86a9246d8ea8df6f433c598d4e881495c2f41457247ba2ae4471e6e1b", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingScanningBody", "file": "lib/l10n/app_en.arb", "location": "pairingScanningBody", "text": "A band that has just come off the charger can take up to half a minute to start advertising.", "sha256": "57c884faf86868405fc205bce25ecac05018be2fa81431fca8456f091bb3ce1a", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingNotFoundTitle", "file": "lib/l10n/app_en.arb", "location": "pairingNotFoundTitle", "text": "No band in range", "sha256": "3532b22d8d202f73cae8c1b5b29dcffedc645f36dcd2e4981a3cb13bd6e8cf8a", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingNotFoundBody", "file": "lib/l10n/app_en.arb", "location": "pairingNotFoundBody", "text": "Nothing answered the scan. The band advertises only when it is awake and not already connected to another phone.", "sha256": "98b7828a8a8410a17b207fc1fb66830975d61f6632717b6c63c7695be210dcb5", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingBondRefusedTitle", "file": "lib/l10n/app_en.arb", "location": "pairingBondRefusedTitle", "text": "The band refused the pairing", "sha256": "66aed617bf3748657d31c83b6058cceaa26046e56fca10ea65fe5065fa1bbe05", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingBondRefusedBody", "file": "lib/l10n/app_en.arb", "location": "pairingBondRefusedBody", "text": "The link came up, but the band would not accept the encryption key. That is almost always a stale pairing record on this phone rather than a fault in the band.", "sha256": "8bc0e74f770dcf08eb63b3ae589c12c698fb71b437f3cf1b19aaf365393c8c91", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingCancelledTitle", "file": "lib/l10n/app_en.arb", "location": "pairingCancelledTitle", "text": "Pairing was cancelled", "sha256": "58587f923ff2852f45dc21c78d24a081e019fe338b63a15108a307e5175bb853", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingCancelledBody", "file": "lib/l10n/app_en.arb", "location": "pairingCancelledBody", "text": "The system picker was dismissed before a band was chosen.", "sha256": "94f48a4dbbd01af3b162a9dfde1cff032e5ac174942b3fb5c123387050ab7607", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingFailedTitle", "file": "lib/l10n/app_en.arb", "location": "pairingFailedTitle", "text": "Pairing did not complete", "sha256": "27e6ed940bbc7d7c10eec8cd45a4dc77543be0db9e25d14e850fda8a43648b8a", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingFailedBody", "file": "lib/l10n/app_en.arb", "location": "pairingFailedBody", "text": "The band was reachable but the session did not finish.", "sha256": "4412caeca7831ab9cc39d8df77ad0ac2a012745674a0e555aecd6ad316e15b20", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingPairedTitle", "file": "lib/l10n/app_en.arb", "location": "pairingPairedTitle", "text": "Paired", "sha256": "651db8587b40535e99027e6819a0e3ffdfee3205199eb6475607c22307fc1e56", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingPairedBody", "file": "lib/l10n/app_en.arb", "location": "pairingPairedBody", "text": "Setting up the first sync.", "sha256": "956630b527daed91646d5671ddc90f5b836510d1eb7e72a95444ab0ad8d2cf6c", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingFindMyBand", "file": "lib/l10n/app_en.arb", "location": "pairingFindMyBand", "text": "Find my band", "sha256": "bb58edd6ab9b9247335ff701ca343c0644dfdd28cc02beca1273ea3327d24d29", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingSearching", "file": "lib/l10n/app_en.arb", "location": "pairingSearching", "text": "Searching…", "sha256": "c31723ab330289fe2cc4c7b69b7a862361da79a01f84893dc7b89a6de0ab4b42", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingOpenPickerAgain", "file": "lib/l10n/app_en.arb", "location": "pairingOpenPickerAgain", "text": "Open the picker again", "sha256": "48e051f37f469a2585829ec8125c72112cafb4592dde08cecde3157be5b6847a", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingTryAgain", "file": "lib/l10n/app_en.arb", "location": "pairingTryAgain", "text": "Try again", "sha256": "d8b8392e2c542950ca64867168e4ef87d4ad606882d5898f826b51c6d553988f", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingNotFoundAdviceTitle", "file": "lib/l10n/app_en.arb", "location": "pairingNotFoundAdviceTitle", "text": "Three things stop a band answering", "sha256": "4b9dabbd99b265d6b6a127adf49c313edfddf412913ab252cc100e797404e260", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingNotFoundAdviceBody", "file": "lib/l10n/app_en.arb", "location": "pairingNotFoundAdviceBody", "text": "It is still on the charger; it is out of range; or it is still connected to another phone or to the vendor app.", "sha256": "35653ac74e84360940cd1b0aa8ca5ef5866af1887ae9cd953b6e546d6df4bd2c", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingNotFoundAdviceFix", "file": "lib/l10n/app_en.arb", "location": "pairingNotFoundAdviceFix", "text": "Force-quit the other app, then scan again", "sha256": "2761783ad185015c784a2ba422b92b4bd860a49841f845fe86fbda0226783407", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingBondRefusedAdviceTitle", "file": "lib/l10n/app_en.arb", "location": "pairingBondRefusedAdviceTitle", "text": "Forget the band in Bluetooth settings first", "sha256": "946e26981e543b6303ff697b8754aeb0e44f61141078b63bdb47446f30a272d4", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingBondRefusedAdviceBody", "file": "lib/l10n/app_en.arb", "location": "pairingBondRefusedAdviceBody", "text": "Open the phone’s Bluetooth settings, forget the band, then scan again here. The refused key is the old pairing record, and only the system can clear it.", "sha256": "b002ef7bd2ea6354a6ca02e8e9c8dfbe608225812efd32fa8695b0b846431717", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingBondRefusedAdviceFix", "file": "lib/l10n/app_en.arb", "location": "pairingBondRefusedAdviceFix", "text": "Open Bluetooth settings", "sha256": "6e63edda23c09869bdedda6a207fa6e4ceffa3a8d9e9e43bc97de08ca32c87a7", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingFailedAdviceTitle", "file": "lib/l10n/app_en.arb", "location": "pairingFailedAdviceTitle", "text": "The band was found but the session did not finish", "sha256": "b14664b14f31d8cc0485d14a1849327875ef4e77c09744cc1dbaf5004bf39883", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:pairingFailedAdviceBody", "file": "lib/l10n/app_en.arb", "location": "pairingFailedAdviceBody", "text": "Scanning again from a metre away normally works.", "sha256": "b9bfec1364ea5750ae27dd4ae8779bd6415a00e27ee47daa10b6d5ac4dccc27c", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupTitle", "file": "lib/l10n/app_en.arb", "location": "profileSetupTitle", "text": "About you", "sha256": "428f4d00b7fff988d67562877fca368cfe17bca6bec8b0995d8b2bfba1b91e30", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupBody", "file": "lib/l10n/app_en.arb", "location": "profileSetupBody", "text": "Four numbers change how your data is scored. Leave any of them blank and only the metrics that need it stay unavailable.", "sha256": "7e4ab7542c0d0d653b65abca27738b1eeeb89b56d8e8197679ff4793ab9be5bc", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupSexHeader", "file": "lib/l10n/app_en.arb", "location": "profileSetupSexHeader", "text": "SEX", "sha256": "b4bed028f83ea70bef67f2902d070ff33be9408bbb495c8731870c0818e2f769", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupSexMale", "file": "lib/l10n/app_en.arb", "location": "profileSetupSexMale", "text": "Male", "sha256": "03f8c1273e3da99bb315fe7b71c8e45159c826e6d3f42eecd4612078248f73a1", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupSexFemale", "file": "lib/l10n/app_en.arb", "location": "profileSetupSexFemale", "text": "Female", "sha256": "e8cca808ae5aaa03a7fc3060856e6d4ad776fb1cb8cfe441a9bd240988cde151", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupSexPreferNotToSay", "file": "lib/l10n/app_en.arb", "location": "profileSetupSexPreferNotToSay", "text": "Prefer not to say", "sha256": "51fcc57e9bf9e07daec711378ec1eed588eadb2d0dc0fbaf4b06ff9e019024f8", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupOtherSexNote", "file": "lib/l10n/app_en.arb", "location": "profileSetupOtherSexNote", "text": "Calories use the mean of the two published sets. Training load and strain have only two published constants and no third, so they use the male pair.", "sha256": "092514c07e3bc38edf7949cf7828e49fd27e6453e56bfb2573bc0de0841272a9", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupAgeLabel", "file": "lib/l10n/app_en.arb", "location": "profileSetupAgeLabel", "text": "AGE", "sha256": "ab864bbd60c5c26b560d20e36107bf5c61e7eeb7c08c1fa751ad92eb210bc0c9", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupAgeUnit", "file": "lib/l10n/app_en.arb", "location": "profileSetupAgeUnit", "text": "years", "sha256": "1c50993b009c62dd6600bc0113d0424f9e8ffee8f7eddb0cdad9d4aad67eb4f6", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupAgeConsequence", "file": "lib/l10n/app_en.arb", "location": "profileSetupAgeConsequence", "text": "Without it: heart-rate zones, calories, fitness age.", "sha256": "9186cdf6691ce0238452fb6baa9dd3c999e94848f15f613109cd99e5286f774d", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupHeightLabel", "file": "lib/l10n/app_en.arb", "location": "profileSetupHeightLabel", "text": "HEIGHT", "sha256": "3054cc69bdb6b323dfa191698ac56036b7f7056a574e4bdfaf1173121166e985", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupHeightConsequence", "file": "lib/l10n/app_en.arb", "location": "profileSetupHeightConsequence", "text": "Without it: stride length, and distance from steps.", "sha256": "9404d4c508420428e48b831ffe6a1d95c0ef54c79ad821b7e4179b793d3efd8c", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupWeightLabel", "file": "lib/l10n/app_en.arb", "location": "profileSetupWeightLabel", "text": "WEIGHT", "sha256": "754bc03a1c16d9029d434c5726260d60285f8dade097b3792de44689800e4b55", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupWeightConsequence", "file": "lib/l10n/app_en.arb", "location": "profileSetupWeightConsequence", "text": "Without it: calories and training load.", "sha256": "35b715df7eb02c50656a2261c659b951bc363ddd6cf70a52b0815d44d3fe658e", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupOptional", "file": "lib/l10n/app_en.arb", "location": "profileSetupOptional", "text": "OPTIONAL", "sha256": "ae26d4ac08c9577600d3bd5e4216327c63d810d698acc680aa058d91487745bb", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:profileSetupPickOneToContinue", "file": "lib/l10n/app_en.arb", "location": "profileSetupPickOneToContinue", "text": "Pick one option above to continue.", "sha256": "5a82b6c563b84002c372ce3e134519a6947471a180e376109ac657b67650195f", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:alarmNavTitle", "file": "lib/l10n/app_en.arb", "location": "alarmNavTitle", "text": "Alarm", "sha256": "f3b67957357963f70aaf939fd76caf4ef15d392889acee40168a2b3e13cede8e", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:alarmNavSub", "file": "lib/l10n/app_en.arb", "location": "alarmNavSub", "text": "Wakes you on the band, not the phone", "sha256": "f67b43e8d2b81aef0c3ae0d013bac412b7a92d3c7dcf1faf9fa3fc3548fdff1a", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:alarmArmedFor", "file": "lib/l10n/app_en.arb", "location": "alarmArmedFor", "text": "ARMED FOR", "sha256": "505ec24944a3d0afe57d60563c2444e77a8d0c93f3ab685c9ec9c0e3c9368ecf", "kind": "arb"}
