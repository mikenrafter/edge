{"id": "lib/data/csv_export.dart:offset-1507", "file": "lib/data/csv_export.dart", "location": "offset-1507", "text": "'Daily metrics'", "sha256": "bb7b9c9fea09f8d2d7f3ba0176b9ef7eaa0cb458fedad749160454e1528071e3", "kind": "dart", "start": 1507, "end": 1522, "line": 45}
{"id": "lib/data/csv_export.dart:offset-2653", "file": "lib/data/csv_export.dart", "location": "offset-2653", "text": "'''\n      SELECT d.date, d.readiness, d.resting_hr, d.hrv, d.sdnn, d.resp_rate,\n             d.stress, d.strain, d.active_calories, d.total_calories,\n             d.sleep_min, d.deep_min, d.rem_min, d.light_min, d.nap_min,\n             d.sleep_efficiency, d.steps, d.worn_min,\n             v.source, v.algo_version\n      FROM v_daily d\n      LEFT JOIN metric_series_version v ON v.date = d.date\n      ORDER BY d.date ASC\n    '''", "sha256": "0e27e9d87ebd544ee0951f231f23e87601fe5a20b22fedeb8886da33e968b417", "kind": "dart", "start": 2653, "end": 3081, "line": 79}
{"id": "lib/data/csv_export.dart:offset-3378", "file": "lib/data/csv_export.dart", "location": "offset-3378", "text": "'''\n      SELECT date, start_ts, end_ts, type, status, duration_min, strain,\n             calories, max_hr, steps, hrr_bpm, source\n      FROM v_sessions ORDER BY start_ts ASC\n    '''", "sha256": "3a539073cb6446af352ef5247cd58e4e5294f858faaca8ef9b528f04607f6d7e", "kind": "dart", "start": 3378, "end": 3560, "line": 107}
{"id": "lib/data/csv_export.dart:offset-3613", "file": "lib/data/csv_export.dart", "location": "offset-3613", "text": "'Sleep stages'", "sha256": "9f7cb7fb7cab68734bc78b10d1ac9e6e0a2d873fb06668644da51321f6b400a0", "kind": "dart", "start": 3613, "end": 3627, "line": 115}
{"id": "lib/data/csv_export.dart:offset-3692", "file": "lib/data/csv_export.dart", "location": "offset-3692", "text": "'SELECT date, start_ts, end_ts, stage FROM v_hypnogram '\n'ORDER BY date ASC, start_ts ASC'", "sha256": "32c3498811a831b7a13f7e72a72f6f7857d02c5c4de953e2351a1e0738a036c2", "kind": "dart", "start": 3692, "end": 3790, "line": 117}
{"id": "lib/data/csv_export.dart:offset-3845", "file": "lib/data/csv_export.dart", "location": "offset-3845", "text": "'Metric history'", "sha256": "68115259de4ca372025aabf599bcb63728b525cf61589320bfc716848b741eaf", "kind": "dart", "start": 3845, "end": 3861, "line": 122}
{"id": "lib/data/csv_export.dart:offset-3911", "file": "lib/data/csv_export.dart", "location": "offset-3911", "text": "'SELECT date, key, value FROM v_metric ORDER BY date ASC, key ASC'", "sha256": "e691379e197fd8ac5e5bd1da4601b60b0988cbbe022c07d3805826b51b663602", "kind": "dart", "start": 3911, "end": 3977, "line": 124}
{"id": "lib/data/csv_export.dart:offset-4440", "file": "lib/data/csv_export.dart", "location": "offset-4440", "text": "\"\"\"\n      SELECT date,\n             CASE WHEN json_valid(tags_json)\n                  THEN COALESCE((SELECT group_concat(value, '; ')\n                                 FROM json_each(journal.tags_json)), '')\n                  ELSE replace(tags_json, char(10), ' ') END AS tags,\n             note\n      FROM journal ORDER BY date ASC\n    \"\"\"", "sha256": "76ec0f7207e348e13fbe29d652e4c422733db970a58d23a718c66c13ccc1d9cb", "kind": "dart", "start": 4440, "end": 4779, "line": 135}
{"id": "lib/data/csv_export.dart:offset-4831", "file": "lib/data/csv_export.dart", "location": "offset-4831", "text": "'Lab results'", "sha256": "b617422f88212348a8d95c41bf0bdd8135e75cbf9e46a36b20bed4a693d67b49", "kind": "dart", "start": 4831, "end": 4844, "line": 147}
{"id": "lib/data/csv_export.dart:offset-4917", "file": "lib/data/csv_export.dart", "location": "offset-4917", "text": "'SELECT taken_on, marker, value, unit, note FROM lab_result '\n'ORDER BY taken_on ASC, marker ASC'", "sha256": "003c54fcde415813291164de9d4af683e22ac23c46f0636ed0a06f31a1711b32", "kind": "dart", "start": 4917, "end": 5022, "line": 149}
{"id": "lib/data/csv_export.dart:offset-5892", "file": "lib/data/csv_export.dart", "location": "offset-5892", "text": "'''\n      SELECT date, at_ts, meal, label, quantity, unit, kcal, protein_g,\n             carbs_g, fat_g, fibre_g, sugar_g, sat_fat_g, sodium_mg, source\n      FROM food_entry ORDER BY date ASC, at_ts ASC\n    '''", "sha256": "e1674834f33cf8893c93d882a6d638ecf459f2dfe030d92262b16c4b584bd09d", "kind": "dart", "start": 5892, "end": 6102, "line": 180}
{"id": "lib/data/csv_export.dart:offset-6506", "file": "lib/data/csv_export.dart", "location": "offset-6506", "text": "'''\n      SELECT d.date, COALESCE(m.label, d.med_key) AS medication,\n             COALESCE(m.kind, '') AS kind, d.slot_min, d.taken_ts, d.skipped,\n             COALESCE(d.dose_value, m.dose_value) AS dose_value,\n             COALESCE(m.dose_unit, '') AS dose_unit, d.note\n      FROM med_dose d LEFT JOIN med_def m ON m.key = d.med_key\n      ORDER BY d.date ASC, d.slot_min ASC\n    '''", "sha256": "f753fc0bd61bc2615b171d542cca52489a792f1454e621ac49e838996d51e824", "kind": "dart", "start": 6506, "end": 6890, "line": 202}
{"id": "lib/data/csv_export.dart:offset-7181", "file": "lib/data/csv_export.dart", "location": "offset-7181", "text": "'''\n      SELECT j.date, j.field, COALESCE(f.label, '') AS label, j.value,\n             COALESCE(f.unit, '') AS unit, j.at_min\n      FROM journal_metric j LEFT JOIN journal_field_def f ON f.key = j.field\n      ORDER BY j.date ASC, j.field ASC\n    '''", "sha256": "0a574eb9f184448de8d244fe26caa428578832e81df6cbb01547a765cc6170f2", "kind": "dart", "start": 7181, "end": 7431, "line": 217}
{"id": "lib/data/csv_export.dart:offset-7487", "file": "lib/data/csv_export.dart", "location": "offset-7487", "text": "'Strength sets'", "sha256": "d4cd42cef00b0f3dfa6fc93eeba81197fb2b25742afddd715c0fc5fb626bf9d6", "kind": "dart", "start": 7487, "end": 7502, "line": 226}
{"id": "lib/data/csv_export.dart:offset-8008", "file": "lib/data/csv_export.dart", "location": "offset-8008", "text": "'''\n      SELECT s.at_ts, s.session_id, s.exercise_key AS exercise,\n             s.set_index, s.reps, s.load_kg, s.rpe, s.hold_sec, s.rest_sec, s.note\n      FROM strength_set s\n      ORDER BY s.at_ts ASC, s.session_id ASC, s.seq ASC\n    '''", "sha256": "c23eaf108b0c32396bdce6842372fb472c2965f0600137d97231851fe2914263", "kind": "dart", "start": 8008, "end": 8248, "line": 243}
