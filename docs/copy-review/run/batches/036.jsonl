{"id": "lib/data/csv_export.dart:offset-8496", "file": "lib/data/csv_export.dart", "location": "offset-8496", "text": "'SELECT started_at, ended_at, pattern, seconds, coherence, '\n'pre_rmssd, post_rmssd FROM breathing_session ORDER BY started_at ASC'", "sha256": "3f270d674a5add97be898d96cfd1ab88d599f0ab24923cbaf867fa2e2bba9725", "kind": "dart", "start": 8496, "end": 8635, "line": 263}
{"id": "lib/data/csv_export.dart:offset-8688", "file": "lib/data/csv_export.dart", "location": "offset-8688", "text": "'Cycle log'", "sha256": "7275b1f117180bad4cbdf82ddeed67dba5e7b6cbb95aef1897551f1086815567", "kind": "dart", "start": 8688, "end": 8699, "line": 268}
{"id": "lib/data/csv_export.dart:offset-9125", "file": "lib/data/csv_export.dart", "location": "offset-9125", "text": "'''\n      SELECT d.date,\n             COALESCE(c.kind, '') AS kind,\n             COALESCE(NULLIF(c.note, ''), s.note, '') AS note,\n             COALESCE(s.symptoms_json, '') AS symptoms\n      FROM (SELECT date FROM cycle_log UNION SELECT date FROM cycle_symptom) d\n      LEFT JOIN cycle_log c ON c.date = d.date\n      LEFT JOIN cycle_symptom s ON s.date = d.date\n      ORDER BY d.date ASC\n    '''", "sha256": "d5df6e57b91a35af91c62dc56571f6c5f4e2cf3bb0d3b76595d96321f9238ac8", "kind": "dart", "start": 9125, "end": 9521, "line": 275}
{"id": "lib/data/csv_export.dart:offset-9951", "file": "lib/data/csv_export.dart", "location": "offset-9951", "text": "'Raw 1 Hz sensor rows and beat-to-beat intervals — millions of rows, and a '\n'spreadsheet cannot open them'", "sha256": "d6f944faf24bd4099bba5263944116357a82eb5c17abbe9c84e828619e601126", "kind": "dart", "start": 9951, "end": 10064, "line": 296}
