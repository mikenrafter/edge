{"id": "lib/compute/manual_session.dart:offset-3281", "file": "lib/compute/manual_session.dart", "location": "offset-3281", "text": "\"That's longer than 24 hours — check the date.\"", "sha256": "8546861aae380f01d2835a14759769fc934c861163df2923e24a11583d171202", "kind": "dart", "start": 3281, "end": 3328, "line": 71}
{"id": "lib/compute/manual_session.dart:offset-3368", "file": "lib/compute/manual_session.dart", "location": "offset-3368", "text": "\"That window hasn't happened yet.\"", "sha256": "354669daf635ea9f144e810424f171afbb10bee6ee036862ef0584b854a6c067", "kind": "dart", "start": 3368, "end": 3402, "line": 72}
