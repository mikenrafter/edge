{"id": "lib/l10n/app_en.arb:settingsWindDownRowTitle", "file": "lib/l10n/app_en.arb", "location": "settingsWindDownRowTitle", "text": "Wind-down", "sha256": "d9abec3065ec7c14a7e5c3aca894307d052b75f33598d7736cb8c8f49da623c2", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsWindDownRowSub", "file": "lib/l10n/app_en.arb", "location": "settingsWindDownRowSub", "text": "A heads-up about 45 minutes before the bedtime learned from your own nights, kept clear of your quiet hours. Appears after about a week of wear", "sha256": "29d1a6bf7182b737a6c9715a7699ff3dcc39dbabb7a38e8d367631c86c89e883", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsStepGoalAlertsRowTitle", "file": "lib/l10n/app_en.arb", "location": "settingsStepGoalAlertsRowTitle", "text": "Step goal alerts", "sha256": "9a3cfd40cfbd4d217e1f71bfd1a149da8fdd59c8f9613709fc07aecf4f3bc145", "kind": "arb"}
