{"id": "lib/l10n/app_en.arb:settingsDetectedWorkoutsRowTitle", "file": "lib/l10n/app_en.arb", "location": "settingsDetectedWorkoutsRowTitle", "text": "Detected workouts", "sha256": "13572be5549fad300d7b7a94605593fbeb2ab0e4a4ef04ee5199484345ffd9db", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsDetectedWorkoutsRowSub", "file": "lib/l10n/app_en.arb", "location": "settingsDetectedWorkoutsRowSub", "text": "Ask about efforts the band spotted that you did not start. Off hides the prompt and the review cards; the band goes on measuring either way", "sha256": "5085819f108e501a9f64339baa95205af89ba39cdad527ddce0b95afcf343b04", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsMovementNudgeRowTitle", "file": "lib/l10n/app_en.arb", "location": "settingsMovementNudgeRowTitle", "text": "Movement nudge", "sha256": "f0bd306ac81cf1452129b6ef2c166151ccb379fcdec1251984f1966762e87dcd", "kind": "arb"}
