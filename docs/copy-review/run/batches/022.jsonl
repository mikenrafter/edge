{"id": "lib/l10n/app_en.arb:settingsMedicationRemindersRowTitle", "file": "lib/l10n/app_en.arb", "location": "settingsMedicationRemindersRowTitle", "text": "Medication reminders", "sha256": "09cc4f7759faafaee13426c90f2980a0585cd27dad475c1486611f64f5758d5b", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsMedicationRemindersRowSub", "file": "lib/l10n/app_en.arb", "location": "settingsMedicationRemindersRowSub", "text": "One notification per scheduled dose, at the times you entered — with a buzz on the band if it is connected. Nothing is sent for a dose already marked taken or skipped", "sha256": "81ab3759fcc191815b177d55ef076fbd0ee42102a23a99b11b0dbddb43513f86", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsDailyCheckInRowTitle", "file": "lib/l10n/app_en.arb", "location": "settingsDailyCheckInRowTitle", "text": "Daily check-in", "sha256": "aa6fb27d2fa8a9e4e75e4151cb655bc5b9cef5728e8953750546535bd1807c76", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsDailyCheckInRowSub", "file": "lib/l10n/app_en.arb", "location": "settingsDailyCheckInRowSub", "text": "One prompt in the evening to write the day — mood, energy, stress. Skipped once the day already has a rating in it", "sha256": "082b437eabdccecc911a07a3fb2c11df60c9912bc3278d9eac0c2cc19fa9bbde", "kind": "arb"}
