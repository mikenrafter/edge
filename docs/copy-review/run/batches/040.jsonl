{"id": "lib/data/db.dart:offset-468758", "file": "lib/data/db.dart", "location": "offset-468758", "text": "'''\n      CREATE TABLE IF NOT EXISTS workout_route (\n        session_id TEXT NOT NULL,\n        seq INTEGER NOT NULL,\n        ts_ms INTEGER NOT NULL,\n        lat REAL NOT NULL,\n        lng REAL NOT NULL,\n        alt REAL,\n        accuracy REAL,\n        PRIMARY KEY (session_id, seq)\n      )\n    '''", "sha256": "1d64fdb0f273bd975ff41c854e03178b45d903993e2a2614486175f76526c7eb", "kind": "dart", "start": 468758, "end": 469055, "line": 10573}
