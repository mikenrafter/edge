{"id": "lib/data/db.dart:offset-470365", "file": "lib/data/db.dart", "location": "offset-470365", "text": "'''\n      CREATE TABLE IF NOT EXISTS workout_split (\n        session_id TEXT NOT NULL,\n        km INTEGER NOT NULL,\n        meters REAL NOT NULL,\n        duration_sec INTEGER NOT NULL,\n        avg_hr REAL,\n        net_elev_m REAL,\n        PRIMARY KEY (session_id, km)\n      )\n    '''", "sha256": "eea890aaa3b1884cfa34dc679120519980d8fb938b4802e257ec297ada82e9b6", "kind": "dart", "start": 470365, "end": 470648, "line": 10610}
