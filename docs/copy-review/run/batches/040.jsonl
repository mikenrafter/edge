{"id": "lib/data/db.dart:offset-475438", "file": "lib/data/db.dart", "location": "offset-475438", "text": "'SELECT s.id AS id, COUNT(d.rec_ts) AS n, AVG(d.hr) AS avg_hr, '\n'       MIN(CASE WHEN 1=1 $floorClause THEN d.hr END) AS min_hr, '\n'       MAX(CASE WHEN 1=1 $ceilClause THEN d.hr END) AS max_hr '\n'FROM sessions s '\n'JOIN decoded_onehz d ON d.rec_ts >= s.start_ts '\n'  AND d.rec_ts <= COALESCE(s.end_ts, s.start_ts) AND d.hr > 0 '", "sha256": "91e33157f4ade0322dbb430328c3d6c5ae632b1cecbfe228965757153c957467", "kind": "dart", "start": 475438, "end": 475798, "line": 10753}
{"id": "lib/data/db.dart:offset-476048", "file": "lib/data/db.dart", "location": "offset-476048", "text": "')} '\n'WHERE s.start_ts >= ? AND s.start_ts <= ? '\n'GROUP BY s.id'", "sha256": "72c11bcd64b2e026e604d12c617ba6db14bf9c43a8e1bae0f036c9ec6d8199d2", "kind": "dart", "start": 476048, "end": 476126, "line": 10762}
{"id": "lib/data/db.dart:offset-477065", "file": "lib/data/db.dart", "location": "offset-477065", "text": "'SELECT s.id AS id, d.hr AS hr '\n'FROM sessions s '\n'JOIN decoded_onehz d ON d.rec_ts >= s.start_ts '\n'  AND d.rec_ts <= COALESCE(s.end_ts, s.start_ts) AND d.hr > 0 '", "sha256": "8b23ba2a7e1cec3401340aba2ed16ebf66425f98930999d55806a390f19f5260", "kind": "dart", "start": 477065, "end": 477249, "line": 10791}
{"id": "lib/data/db.dart:offset-477499", "file": "lib/data/db.dart", "location": "offset-477499", "text": "')} '\n'WHERE s.start_ts >= ? AND s.start_ts <= ? '\n'ORDER BY s.id, d.rec_ts ASC'", "sha256": "eca009b4051140981de659d63fe2f6349bb3eab1b88f7359ce54b505542a0748", "kind": "dart", "start": 477499, "end": 477591, "line": 10798}
