{"id": "lib/l10n/app_en.arb:settingsImportEmptyWithBirthday", "file": "lib/l10n/app_en.arb", "location": "settingsImportEmptyWithBirthday", "text": "Nothing came back. {store} holds no height, weight, birthday or sex for you — type them in here instead.", "sha256": "832bc3ba1008c737fa95e84d0fd218f4e1f7cf576439ac42cd366b7248ba6b74", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsImportEmpty", "file": "lib/l10n/app_en.arb", "location": "settingsImportEmpty", "text": "Nothing came back. {store} holds no height, weight or sex for you — type them in here instead.", "sha256": "61e83392f3e5a37f67b5c4ad290d3bcdf8ef795e1d3c57e9227a3dc68c7c018c", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsImportNoChange", "file": "lib/l10n/app_en.arb", "location": "settingsImportNoChange", "text": "Read {fields}. Your profile already says the same thing, so nothing changed.", "sha256": "20f01790ec76348ab16e7a368c5157d6880fd43fac389bccc61379196fcbe864", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsImportUpdated", "file": "lib/l10n/app_en.arb", "location": "settingsImportUpdated", "text": "Updated {fields} from {store}.", "sha256": "9f6ca717754e766dae9c4f04b69e5424734b3efe45009c41b56cf1802397ea6e", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsImportFailed", "file": "lib/l10n/app_en.arb", "location": "settingsImportFailed", "text": "Failed: {error}", "sha256": "64c14e352881ed910a7ebd1be1ade043ff5b0b8dc057af930173ee153ff21310", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsAgeFieldLabel", "file": "lib/l10n/app_en.arb", "location": "settingsAgeFieldLabel", "text": "Age", "sha256": "39b7370f30a361390476a93a9e57c0654e35aefeda4c0c866aa1fd0dc05cdf19", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsEditProfileNavTitle", "file": "lib/l10n/app_en.arb", "location": "settingsEditProfileNavTitle", "text": "Edit profile", "sha256": "15c4aa13037eaf52733882a470415c0f5a4afa8490b49dc1712b1f96fc3b1de0", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsNameFieldLabel", "file": "lib/l10n/app_en.arb", "location": "settingsNameFieldLabel", "text": "NAME", "sha256": "eaa589322731009980d99891b5c7850ac5172dda7cdf73a533ab403332d7e944", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsSexFieldLabel", "file": "lib/l10n/app_en.arb", "location": "settingsSexFieldLabel", "text": "SEX", "sha256": "b4bed028f83ea70bef67f2902d070ff33be9408bbb495c8731870c0818e2f769", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsSexMale", "file": "lib/l10n/app_en.arb", "location": "settingsSexMale", "text": "Male", "sha256": "03f8c1273e3da99bb315fe7b71c8e45159c826e6d3f42eecd4612078248f73a1", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsSexFemale", "file": "lib/l10n/app_en.arb", "location": "settingsSexFemale", "text": "Female", "sha256": "e8cca808ae5aaa03a7fc3060856e6d4ad776fb1cb8cfe441a9bd240988cde151", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsSexPreferNotToSay", "file": "lib/l10n/app_en.arb", "location": "settingsSexPreferNotToSay", "text": "Prefer not to say", "sha256": "51fcc57e9bf9e07daec711378ec1eed588eadb2d0dc0fbaf4b06ff9e019024f8", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsAgeYearsFieldLabel", "file": "lib/l10n/app_en.arb", "location": "settingsAgeYearsFieldLabel", "text": "AGE (YEARS)", "sha256": "eee0e1f2ae6f2181f4d82a06df8e2f54297cba8fea192aa5bf629a20929c2934", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsFourFieldsTitle", "file": "lib/l10n/app_en.arb", "location": "settingsFourFieldsTitle", "text": "These four change your numbers", "sha256": "a587671ce215b8f1c2be70f3608ec4b006e9671dd65a5d771f5f06b0326f1967", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsFourFieldsBody", "file": "lib/l10n/app_en.arb", "location": "settingsFourFieldsBody", "text": "They feed heart-rate zones, calorie estimates and training load. Clear one and only the metrics that need it stay unavailable.", "sha256": "f3f233631c6f6fd91119a7c7f16b8641e4e4cd370e430fc0fe367af3a6745765", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsImportBlockAppleHealth", "file": "lib/l10n/app_en.arb", "location": "settingsImportBlockAppleHealth", "text": "Height, weight, birthday and sex, straight out of {store}. Height and weight are taken every time; your age and sex only fill a gap, because neither drifts and a value already here was your choice.", "sha256": "fe66c0cb4c00cbdd476dfcfbe4aa6dd338d9a7f5e0857fe4388bbedd6bdf95ad", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsImportBlockOther", "file": "lib/l10n/app_en.arb", "location": "settingsImportBlockOther", "text": "Height and weight, straight out of {store}. It has no birthday and no sex to read — no app can — so set those two above yourself.", "sha256": "7bc5dfc96a76141cb3284c7ebf6988856268826e48e57793eb4c83d687e2423a", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsNotSetHint", "file": "lib/l10n/app_en.arb", "location": "settingsNotSetHint", "text": "Not set", "sha256": "4895f73177ab5d67c30c183a49d2477e014a2ef69b65150762d17e877f4f5b95", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsAutomationNavTitle", "file": "lib/l10n/app_en.arb", "location": "settingsAutomationNavTitle", "text": "Automation", "sha256": "d909750b1bbb71a39b6330ba8f81f4f8f6e889ed96d7ab366e74857909750c64", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsSyncFinishesSectionTitle", "file": "lib/l10n/app_en.arb", "location": "settingsSyncFinishesSectionTitle", "text": "When a sync finishes", "sha256": "8857af9fd2613ff89a8a158746a7d14f79e3964772bb1f766c1b3e169b50c101", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsSyncFinishesAndroidBody", "file": "lib/l10n/app_en.arb", "location": "settingsSyncFinishesAndroidBody", "text": "The app broadcasts an intent your automation app can start a profile on. Filter on the action below; it carries how many records landed and when, at most one a minute.", "sha256": "a636ec7376c2c116e5e8d40d90bc88bb1a15eead5673175ca5d2d8a25046865b", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsSyncFinishesIosBody", "file": "lib/l10n/app_en.arb", "location": "settingsSyncFinishesIosBody", "text": "iOS cannot do this. A Shortcuts personal automation can only trigger on Apple’s own fixed list of events, and no app can add one — so nothing here can start a shortcut for you. Android gets it; this is a platform limit, not a setting.", "sha256": "0411b5f81f822ab6dceea11873b7d3c0e89ccd7f9f10572b94db456cfc41d7dc", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsSyncFinishesExtras", "file": "lib/l10n/app_en.arb", "location": "settingsSyncFinishesExtras", "text": "Extras: records (int), at (unix seconds)", "sha256": "ee48923fa054e604600986b3f4fffd16409dd26065a8e986b5adbd1f4d866789", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsNeverSendSectionTitle", "file": "lib/l10n/app_en.arb", "location": "settingsNeverSendSectionTitle", "text": "What it will never send", "sha256": "9b2a315a6b91a61d473be639c628f40d9b6234c92f03c43e96a53cea27230ef4", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsNeverSendBody", "file": "lib/l10n/app_en.arb", "location": "settingsNeverSendBody", "text": "No readiness, no strain, no sleep score — on either platform. A number this app would have shown as absent, with a reason attached, becomes a bare zero the moment it leaves. Facts about the sync go out; measurements do not.", "sha256": "0487fd6b0bb153b2bf5ff01bbd4508fbb59e30ca43b3ba99c1d1ebdfcdcebaaf", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsBuzzFromShortcutSectionTitle", "file": "lib/l10n/app_en.arb", "location": "settingsBuzzFromShortcutSectionTitle", "text": "Buzzing the band from a shortcut", "sha256": "dd8830c61ab4892b2c08dd3f3e03e7c3a7a02b97dd6854a16d99595d482b93f1", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsBuzzFromShortcutAndroidBody", "file": "lib/l10n/app_en.arb", "location": "settingsBuzzFromShortcutAndroidBody", "text": "Send wtf.openstrap.openstrap_edge.BUZZ_STRAP with this token as the “token” string extra. Without it any app on the phone could buzz your band.", "sha256": "fce383668d40e8b3299350cd840c535bfc87c63f4abdd3db7f3b8dbe645faac3", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsBuzzFromShortcutIosBody", "file": "lib/l10n/app_en.arb", "location": "settingsBuzzFromShortcutIosBody", "text": "This direction works on iOS: a shortcut you run yourself can reach the app. What it cannot do is run itself when the band syncs.", "sha256": "8aae0a6311b02375a95c5d4eb8d7474ac905236293cf21b7eff9cf7fbff3be87", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsNoTokenYet", "file": "lib/l10n/app_en.arb", "location": "settingsNoTokenYet", "text": "No token yet — reopen this screen.", "sha256": "b4feb6c59f182f95c41af769cadad4b8c68ad6e308812a63e04d87ad92a8e781", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsCopied", "file": "lib/l10n/app_en.arb", "location": "settingsCopied", "text": "Copied", "sha256": "8d525e5f158b9afe05f3122af363ac67763bdc4e1395b46597b320c289766ce3", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:settingsCopyTheToken", "file": "lib/l10n/app_en.arb", "location": "settingsCopyTheToken", "text": "Copy the token", "sha256": "b9971b1742a66ab40466dc60795983fa9a93b3db531e6d5b1f8362a1f6151f0d", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusBluetoothDeniedTitle", "file": "lib/l10n/app_en.arb", "location": "bandStatusBluetoothDeniedTitle", "text": "Bluetooth is switched off for this app", "sha256": "4a6c14188e9fcc128b59fc9b630543cd5cef408a8444f8765d773ea261e51bea", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusBluetoothDeniedReason", "file": "lib/l10n/app_en.arb", "location": "bandStatusBluetoothDeniedReason", "text": "The phone is withholding the Bluetooth radio from OpenStrap, so nothing can be scanned or connected. This is not the band — walking closer to it will not help.", "sha256": "22171c8793f2f27ff07a70e61e7114e9bcbfb9000abd543cc65ea927ad70a826", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusBluetoothDeniedFix", "file": "lib/l10n/app_en.arb", "location": "bandStatusBluetoothDeniedFix", "text": "Open Settings → OpenStrap and allow Bluetooth", "sha256": "ed47cb8cbb362ac79017ae022162c2042576f9c2982b4b600ecb5db9040e60c3", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusBluetoothOffTitle", "file": "lib/l10n/app_en.arb", "location": "bandStatusBluetoothOffTitle", "text": "Bluetooth is turned off", "sha256": "ec245d91ef26113cec4eae5d2dc60bd5cd404fb32798bbf91a326de4d24e44c9", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusBluetoothOffReason", "file": "lib/l10n/app_en.arb", "location": "bandStatusBluetoothOffReason", "text": "The phone’s radio is off, so the band cannot be reached by any app. The band keeps recording meanwhile; nothing is lost.", "sha256": "519ab3baf96b8c16db50e166844a590dc832311100c57799e9c25e577d152e6a", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusBluetoothOffFix", "file": "lib/l10n/app_en.arb", "location": "bandStatusBluetoothOffFix", "text": "Turn Bluetooth on", "sha256": "6a317217b52bafe67c4252ece5b338548a077d110765dcf60f9f22422ee5f90d", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusBluetoothUnsupportedTitle", "file": "lib/l10n/app_en.arb", "location": "bandStatusBluetoothUnsupportedTitle", "text": "This phone has no Bluetooth Low Energy radio", "sha256": "b23748bf5db25de0b83f73ffab80dc424f392cdbc280a7af6f3718576cca7df9", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusBluetoothUnsupportedReason", "file": "lib/l10n/app_en.arb", "location": "bandStatusBluetoothUnsupportedReason", "text": "The band can only be reached over Bluetooth Low Energy. Imported data still works; a live link does not.", "sha256": "4b79205cdf7dc9a089cb3b591ade9d5c8410a7ce28813dc4eb8c2c57e00326c7", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusReconnectPausedTitle", "file": "lib/l10n/app_en.arb", "location": "bandStatusReconnectPausedTitle", "text": "Reconnecting has been paused", "sha256": "4dcfbf2c6425162cb1aa3c1a6519629ed78bdd24ec8e236b800823385980ccf9", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusReconnectPausedReason", "file": "lib/l10n/app_en.arb", "location": "bandStatusReconnectPausedReason", "text": "The band refused the pairing key {n, plural, one{{n} time} other{{n} times}} in a row, so the app stopped retrying rather than pin the radio and drain both batteries on a link that will not open. Nothing is reconnecting until you act.", "sha256": "16c1d2fdf595895d79e807e7f96ec4d6648b0c28f0d1eb8607a8212ea2f9edeb", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusRepairNeededTitle", "file": "lib/l10n/app_en.arb", "location": "bandStatusRepairNeededTitle", "text": "The band needs to be paired again", "sha256": "3d5c5ebe93dd8641330a3342a122855a17b3f3b356263af097c9f36bbd09a8c6", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusRepairNeededReason", "file": "lib/l10n/app_en.arb", "location": "bandStatusRepairNeededReason", "text": "The link comes up, but the band rejects the encryption key the phone holds, so every command is dropped and no data moves. Your recordings are safe on the band.", "sha256": "1c5fce4e6e3220454568175e89572640801b72f6d86646692468eb72e9372dc1", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusRepairFix", "file": "lib/l10n/app_en.arb", "location": "bandStatusRepairFix", "text": "Forget the band in the phone’s Bluetooth settings, then pair it again here", "sha256": "512bc356b05a344b4ea377e624531ebc193159e97250a1434ee1fba00073388d", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusSyncStuckTitle", "file": "lib/l10n/app_en.arb", "location": "bandStatusSyncStuckTitle", "text": "One batch of recordings will not finish transferring", "sha256": "b19911597d71aaf2473126425ea180e47ffec5f60cfc14f91c1d2265ca404704", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusSyncStuckReason", "file": "lib/l10n/app_en.arb", "location": "bandStatusSyncStuckReason", "text": "The band keeps re-sending the same batch because the app cannot get its confirmation through. Everything in it is already saved here — nothing is lost — but the band cannot move on until the confirmation lands.", "sha256": "e49b73e60040a5f7ea0cf7c2224e5a5410fcc7a82c8aaa9fba6e39ca385c5063", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusSyncStuckFix", "file": "lib/l10n/app_en.arb", "location": "bandStatusSyncStuckFix", "text": "Reconnect the band; if it repeats tomorrow, pair it again", "sha256": "da068a43a8292ff057ecddec5245ce62bfcd55ce2f681ed3ac774b8fbb5d6a52", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusStrapUnresponsiveTitle", "file": "lib/l10n/app_en.arb", "location": "bandStatusStrapUnresponsiveTitle", "text": "The band has stopped handing over its recordings", "sha256": "b875ad3d4441a12346121a09f59d6ea6272ed226d49a6ad6eb183f0369d22d06", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusStrapUnresponsiveReason", "file": "lib/l10n/app_en.arb", "location": "bandStatusStrapUnresponsiveReason", "text": "The band reports newer recordings than it will send. Those recordings are still on the band and still safe; it just is not passing them across.", "sha256": "304a90fe5085a88f9606dca544d569c6614115ce9df6548795e73f3932359cd6", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusStrapUnresponsiveFix", "file": "lib/l10n/app_en.arb", "location": "bandStatusStrapUnresponsiveFix", "text": "Put the band on its charger for a minute, then reconnect", "sha256": "899e45125730ad9ea5ff5cb90c53308a1fc2c5729a5c420d3fac5ff6fb1a222b", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusClockLostTitle", "file": "lib/l10n/app_en.arb", "location": "bandStatusClockLostTitle", "text": "Syncs are finishing with no data in them", "sha256": "b24d29787acab13a155b197d1cab5059a833854d41e66fbea9ac7ce0ddc632d4", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusClockLostReason", "file": "lib/l10n/app_en.arb", "location": "bandStatusClockLostReason", "text": "The band completes each sync without handing over a single sensor reading, which almost always means its onboard clock has lost sync. The app keeps resetting it on every connect.", "sha256": "c8ef32b4917955a136adce6e0ac5c6ad0b0644344f23fe2088f0fcfde7436e31", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusClockLostFix", "file": "lib/l10n/app_en.arb", "location": "bandStatusClockLostFix", "text": "Leave the band connected for a few minutes; if nothing arrives by tomorrow, pair it again", "sha256": "dfc3605e9a42e89b59c1cc48d67027ed741ebb907dba7f15303d2ba8022ab7f4", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusConnectedReason", "file": "lib/l10n/app_en.arb", "location": "bandStatusConnectedReason", "text": "The band is linked and handing over its recordings.", "sha256": "d7b08d3f4364ea6b63aea06a42ce01531ce366a07e4edc23e1c8f8dd4750ce5f", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusConnectingTitle", "file": "lib/l10n/app_en.arb", "location": "bandStatusConnectingTitle", "text": "Connecting", "sha256": "d403c686f6a1048014bdd230f59963271b0123ea48245754fc9f264b962a2182", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusConnectingReason", "file": "lib/l10n/app_en.arb", "location": "bandStatusConnectingReason", "text": "Opening the link to the band.", "sha256": "84c79a2f0898da9e00d830307cbf9fad07b4c77f6e0e8cdea2a7352f7a9962dc", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusScanningTitle", "file": "lib/l10n/app_en.arb", "location": "bandStatusScanningTitle", "text": "Looking for the band", "sha256": "0b3b18c84022d8ba7137044c05cc396596eb119c08da1dbf1d4437a6d75b5236", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusScanningReason", "file": "lib/l10n/app_en.arb", "location": "bandStatusScanningReason", "text": "Listening for the band to advertise itself.", "sha256": "5f213372b4d60754fbcb7460b2c3b9513bd416908a0b0ae6acfb32ff1bb97d03", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusDisconnectedReason", "file": "lib/l10n/app_en.arb", "location": "bandStatusDisconnectedReason", "text": "The band is out of range, on its charger, or held by another app. It keeps recording either way.", "sha256": "077bb59336868f6b3a1312d40ebf880e813843e7f1cb29f9b570b6fcbc64a439", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandStatusDisconnectedFix", "file": "lib/l10n/app_en.arb", "location": "bandStatusDisconnectedFix", "text": "Bring the band near the phone, and close any other app connected to it", "sha256": "695078a149fdec4c19188802bf7588ce2b17746b3cba91bcecc2fe72e70e6959", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:devicesTierBeatToBeatLabel", "file": "lib/l10n/app_en.arb", "location": "devicesTierBeatToBeatLabel", "text": "Beat-to-beat intervals", "sha256": "b8dfd89da0b74b9bda380e07450bb8d4bbf8293ccdc56be4b508b2cec875b7f2", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:devicesTierBeatToBeatDetail", "file": "lib/l10n/app_en.arb", "location": "devicesTierBeatToBeatDetail", "text": "Electrical R-peak detection.", "sha256": "13a5d3eec3d29f592bd9697e9cbf97a173104492c4e3b572f1577e3c83528600", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:devicesTierWristOpticalLabel", "file": "lib/l10n/app_en.arb", "location": "devicesTierWristOpticalLabel", "text": "Wrist optical pulse", "sha256": "2730a5ce17d79900250acf7df3520f4a5932794c933e977441be675dce4f262e", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:devicesTierWristOpticalDetail", "file": "lib/l10n/app_en.arb", "location": "devicesTierWristOpticalDetail", "text": "Continuous 24/7 pulse, sleep and temperature. Beat timing is inferred from a pulse wave, so HRV here is PRV.", "sha256": "ea329dcbf31a228a59d3f991e7b8b21e92f53a0aed3c9042ae80d7f39c0cdeec", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:devicesTierPhoneLabel", "file": "lib/l10n/app_en.arb", "location": "devicesTierPhoneLabel", "text": "Steps only", "sha256": "67afc624a6ceaefb6af3f6310a1c31015d8cb5f8c7f3f7d36a4db31e47383eb7", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:devicesTierPhoneDetail", "file": "lib/l10n/app_en.arb", "location": "devicesTierPhoneDetail", "text": "The phone’s own motion coprocessor. Steps and nothing else.", "sha256": "712ff2c367ae2232b759fb6fcd664c26e2473f3e0f587528aff9ef92218c80f8", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:deviceActionNoneLabel", "file": "lib/l10n/app_en.arb", "location": "deviceActionNoneLabel", "text": "Do nothing", "sha256": "e66b291192aa84ad61215ab4088c33788f16cced0023f7701058f98d10c9c104", "kind": "arb"}
