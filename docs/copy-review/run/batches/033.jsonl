{"id": "lib/coach/coach_actions.dart:offset-15153", "file": "lib/coach/coach_actions.dart", "location": "offset-15153", "text": "'Field \"$key\" needs a number.'", "sha256": "fdbfffadb7be2ef2c1da54d1c8824d4f336d2a4c4f4347792e30446842351260", "kind": "dart", "start": 15153, "end": 15183, "line": 365}
