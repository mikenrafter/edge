{"id": "lib/data/db.dart:offset-111133", "file": "lib/data/db.dart", "location": "offset-111133", "text": "'''\n      CREATE TABLE IF NOT EXISTS observation (\n        device_id    TEXT NOT NULL DEFAULT '',\n        ts_ms        INTEGER NOT NULL,\n        date         TEXT NOT NULL,\n        source_kind  TEXT NOT NULL,\n        vendor_key   TEXT,\n        key          TEXT,\n        value        REAL,\n        unit         TEXT,\n        attribution  TEXT NOT NULL,\n        CHECK (vendor_key IS NOT NULL OR key IS NOT NULL)\n      )\n    '''", "sha256": "7308a3c537afd7ca0667f2703600c5d904ec3abffcca9d967c6fe8c56e894d34", "kind": "dart", "start": 111133, "end": 111559, "line": 2338}
