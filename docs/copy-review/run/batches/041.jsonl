{"id": "lib/data/nutrition_store.dart:offset-2224", "file": "lib/data/nutrition_store.dart", "location": "offset-2224", "text": "'''\n    CREATE TABLE IF NOT EXISTS food_def (\n      key            TEXT PRIMARY KEY,\n      label          TEXT NOT NULL,\n      brand          TEXT NOT NULL DEFAULT '',\n      serving_g      REAL,\n      serving_label  TEXT NOT NULL DEFAULT '',\n      kcal_100       REAL,\n      protein_g_100  REAL,\n      carbs_g_100    REAL,\n      fat_g_100      REAL,\n      fibre_g_100    REAL,\n      sugar_g_100    REAL,\n      sat_fat_g_100  REAL,\n      sodium_mg_100  REAL,\n      iron_mg_100    REAL,\n      calcium_mg_100 REAL,\n      source         TEXT NOT NULL DEFAULT 'manual',\n      created_at     INTEGER NOT NULL\n    )\n  '''", "sha256": "ebf4faf8bb1404077ed306a7abbcfd0fbfcfb4f11bcff20cc01ca4480bf98191", "kind": "dart", "start": 2224, "end": 2838, "line": 59}
{"id": "lib/data/nutrition_store.dart:offset-15765", "file": "lib/data/nutrition_store.dart", "location": "offset-15765", "text": "'at_ts ASC, created_at ASC'", "sha256": "f2cb273dad5ff31415ca6cde7b9070a90552f96a4935b72aff7fa59ecdb5d63a", "kind": "dart", "start": 15765, "end": 15792, "line": 485}
