{"id": "lib/data/nutrition_store.dart:offset-16734", "file": "lib/data/nutrition_store.dart", "location": "offset-16734", "text": "'SELECT * FROM food_entry WHERE id IN '\n'(SELECT MAX(id) FROM food_entry GROUP BY label) '\n'ORDER BY created_at DESC LIMIT ?'", "sha256": "279342d933b63b5a9411771160f037f4952175a69b2f40451ac08d71c90d5d5c", "kind": "dart", "start": 16734, "end": 16871, "line": 515}
{"id": "lib/data/nutrition_store.dart:offset-17297", "file": "lib/data/nutrition_store.dart", "location": "offset-17297", "text": "\"SELECT * FROM food_def WHERE label LIKE ? OR brand LIKE ? \"\n\"ORDER BY (source = 'verified') DESC, label ASC LIMIT ?\"", "sha256": "90baa3fa49e4823de8acdb90d111efdf41c375d50dfac39782bd8edf6c41fc6b", "kind": "dart", "start": 17297, "end": 17420, "line": 533}
