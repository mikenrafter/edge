{"id": "lib/ui2/screens/metric_detail.dart:offset-13401", "file": "lib/ui2/screens/metric_detail.dart", "location": "offset-13401", "text": "'Skin temperature'", "sha256": "79eb168baa9823a9048b1ebfbe0d74e8935f1365a3be644b7c641bc0c3f6f1d9", "kind": "dart", "start": 13401, "end": 13419, "line": 356}
