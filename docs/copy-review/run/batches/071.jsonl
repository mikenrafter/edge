{"id": "lib/ui2/screens/metric_detail.dart:offset-11136", "file": "lib/ui2/screens/metric_detail.dart", "location": "offset-11136", "text": "'Night-to-night coefficient of variation of RMSSD.'", "sha256": "27871efef82fbfcaa32a0201bf080a59176b313a7dc0611a9be0a008bd1d0549", "kind": "dart", "start": 11136, "end": 11187, "line": 298}
