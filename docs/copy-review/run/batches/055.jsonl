{"id": "lib/ui2/profile/data.dart:offset-10490", "file": "lib/ui2/profile/data.dart", "location": "offset-10490", "text": "'${kCsvExportSets.length} CSV files — daily metrics, '\n'workouts, sleep, journal, labs, and everything you '\n'typed in. Each day carries where it came from and '\n'which algorithm version scored it'", "sha256": "37006cdf5b94d22e2da8f77a014c2cc54ad91201e8e9e35152e67c150d57de03", "kind": "dart", "start": 10490, "end": 10777, "line": 263}
