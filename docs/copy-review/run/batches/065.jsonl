{"id": "lib/ui2/screens/day_timeline.dart:offset-34567", "file": "lib/ui2/screens/day_timeline.dart", "location": "offset-34567", "text": "'What was logged for it is below.'", "sha256": "e5733240ad9afabb45285cc05a9bdd23b1dcb30a21f869c835c7781d4a1e7a15", "kind": "dart", "start": 34567, "end": 34601, "line": 934}
