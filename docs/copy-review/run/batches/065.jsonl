{"id": "lib/ui2/screens/cycle_screen.dart:offset-31552", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-31552", "text": "'tender breasts'", "sha256": "1535157a14b79613f5189ec8e72f399dbaeb51ed37f3baf44611d9bc11bd4c31", "kind": "dart", "start": 31552, "end": 31568, "line": 837}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-31859", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-31859", "text": "'Ovulation window'", "sha256": "d1d4e486f6a82f2e058f3a8a6350453dc15444294124ae376e9e26ca1e3e1759", "kind": "dart", "start": 31859, "end": 31877, "line": 845}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-37341", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-37341", "text": "'Across your cycles'", "sha256": "acdc2777cc84ecb249ac20eb7f79be9a91543aa980f72d7a88742e5145c038f4", "kind": "dart", "start": 37341, "end": 37361, "line": 990}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-37436", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-37436", "text": "'This cycle'", "sha256": "71f11ee0beb79e2d6be4024c68a41f313833e07fbcc3bf3c9d8bb067b1ed1d25", "kind": "dart", "start": 37436, "end": 37448, "line": 992}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-37519", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-37519", "text": "'By day of your cycle'", "sha256": "01a34ea2eba7750c0238539c8557893fbe70f0cbf66b6b94a2c0d88ef665ec6b", "kind": "dart", "start": 37519, "end": 37541, "line": 993}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-37607", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-37607", "text": "'How long your cycles have been'", "sha256": "23f76978d33b18f7d1ed32ea70174ecbe1dc7f3661053d366ed4ea2aae3a8796", "kind": "dart", "start": 37607, "end": 37639, "line": 995}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-38243", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-38243", "text": "'Resting heart rate'", "sha256": "8109f61a2ba69dd70f43fd8f6773ad54824d10b44e2393208cecbcb21003e97d", "kind": "dart", "start": 38243, "end": 38263, "line": 1014}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-38702", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-38702", "text": "'Not enough cycles to describe a cycle day yet'", "sha256": "18bd747e4e685a16779610038313e0a9574fe4e668a718caca84160f371a172a", "kind": "dart", "start": 38702, "end": 38749, "line": 1032}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-38807", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-38807", "text": "'Every point here is the middle of the same day across two or more of '\n'your own cycles. Nothing has two behind it yet.'", "sha256": "5e605397a622eec35b57cd47aeadba1ed2092d9b843ae0902fe77bccfdd03d0f", "kind": "dart", "start": 38807, "end": 38944, "line": 1034}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-39256", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-39256", "text": "'Your own past cycles, described. Days that only one cycle reached '\n'are left empty rather than drawn — one night is not a middle. It '\n'describes what happened, not what will.'", "sha256": "403226d2b940714919195b598887e920abe0d7a06c3f2f441db7ebe645cc45b4", "kind": "dart", "start": 39256, "end": 39470, "line": 1046}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-43075", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-43075", "text": "'Resting heart rate'", "sha256": "8109f61a2ba69dd70f43fd8f6773ad54824d10b44e2393208cecbcb21003e97d", "kind": "dart", "start": 43075, "end": 43095, "line": 1136}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-43291", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-43291", "text": "'Not enough cycles to compare a day against itself'", "sha256": "8a846eafcd6740bad8647a097c104a87fbf8369099a27baba566b1c414c477a4", "kind": "dart", "start": 43291, "end": 43342, "line": 1144}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-43426", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-43426", "text": "'This puts today next to the same day of your own previous '\n'cycles. It needs three of them that got that far.'", "sha256": "eb5b10b500c2b516cf70c5a58c33c8ed60cad049baa3e671a2e06af3f924e80f", "kind": "dart", "start": 43426, "end": 43560, "line": 1147}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-43629", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-43629", "text": "'This puts today next to the same day of your own previous '\n'cycles. It needs three of them that reached day $cd.'", "sha256": "9d06534ca9c837a2080034239f30530ed750dd7b92d43853678d3ebd4216c9b7", "kind": "dart", "start": 43629, "end": 43766, "line": 1150}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-44447", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-44447", "text": "'NIGHT OF ${_short(night.last, l).toUpperCase()}'", "sha256": "e3279a1a16250817db5d9a11cbee1399b7143b32cee03617c17bd894cb2f0060", "kind": "dart", "start": 44447, "end": 44496, "line": 1170}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-44871", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-44871", "text": "'A comparison, not a correction. Nothing on your readiness has '\n'been rescaled by this, and nothing here is a training '\n'instruction.'", "sha256": "24338bfb25a61218e6821d87766ba0bee4e5381298d126bda80cfca918fdcb1c", "kind": "dart", "start": 44871, "end": 45047, "line": 1181}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-47006", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-47006", "text": "'$label ${_signed(z1, dp)} vs your last 3 weeks, '\n'${_signed(z2, dp)} vs your last ${sameDay.length} day-${cycleDay}s.'", "sha256": "10e3e866026ef33c10e6eb2601885f55ce86d10bbffb4680ff0d8aa951c61875", "kind": "dart", "start": 47006, "end": 47138, "line": 1235}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-47732", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-47732", "text": "'Your cycle lengths against a published range'", "sha256": "5c6dc781bd52495b8d9e77da462d8e5cb90324fbaa441a6b9921859ad7939ba7", "kind": "dart", "start": 47732, "end": 47778, "line": 1253}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-47823", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-47823", "text": "'Off unless you ask for it. It draws the days between your own logged '\n'starts next to the range published for an adult cycle, and says '\n'nothing else about them.'", "sha256": "3bd7927726c371b0031b21eb715877aa414ec75cf0db21991e3f84bcef613c8a", "kind": "dart", "start": 47823, "end": 48020, "line": 1255}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-48053", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-48053", "text": "'Show it'", "sha256": "804dc3a12937e8c83f998ba0e9cc26742c70061bfcfd09e83177e825a435b768", "kind": "dart", "start": 48053, "end": 48062, "line": 1258}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-48347", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-48347", "text": "'Not enough logged cycles yet'", "sha256": "174bf0a6dbe9ddb16037a4cad9c505c2684519b9ca49a05aabd916e7a838c2db", "kind": "dart", "start": 48347, "end": 48377, "line": 1267}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-48513", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-48513", "text": "'This needs a long run: ${gaps.length} of '\n'$kCycleLengthReviewMinGaps gaps so far, which is about a year of '\n'logging every start.'", "sha256": "7162c5f0e93b3e4d580a18d8ee678c27b08308325d74e341c36c24cbecbe3218", "kind": "dart", "start": 48513, "end": 48679, "line": 1272}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-48885", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-48885", "text": "'There is a gap in your logged starts'", "sha256": "cc0cede88122e720971cc3a58964688a1fcfc791e8213a0583029e9bc5683e33", "kind": "dart", "start": 48885, "end": 48923, "line": 1281}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-48995", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-48995", "text": "'One of them is more than $kCycleLengthUnloggableGapDays days after '\n'the one before it. A start you never logged and a cycle that '\n'genuinely ran that long look the same from here, so nothing is '\n'drawn.'", "sha256": "d1d0cd507b5eff9bfb89eb360650ec7a4a7b7718ab3d2b2ec1578fc80e690618", "kind": "dart", "start": 48995, "end": 49251, "line": 1283}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-50074", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-50074", "text": "'Days between your logged starts'", "sha256": "9f2bf2960532f78d50d70d17def69f327048343461fef7542fd407e7912ebf8a", "kind": "dart", "start": 50074, "end": 50107, "line": 1308}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-50373", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-50373", "text": "'Your cycles'", "sha256": "b490a92817d25dc45635333bec45ed95df27c1eae633c82c0fd702cf7610ea85", "kind": "dart", "start": 50373, "end": 50386, "line": 1316}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-50450", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-50450", "text": "'Published range'", "sha256": "eddb8156683712880237cc7d436b6088076949d2f080bca3875037b5a8ae289b", "kind": "dart", "start": 50450, "end": 50467, "line": 1317}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-50697", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-50697", "text": "'The two lines are ${kPublishedCycleDays.low.round()} and '\n'${kPublishedCycleDays.high.round()} days.'", "sha256": "d5718f491bd06dd54e396665f77f27eecb37a01e8730ba6585b93ed692cdbc85", "kind": "dart", "start": 50697, "end": 50820, "line": 1324}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-51722", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-51722", "text": "'Cycle length changes for many reasons — thyroid, stress, weight '\n'change, contraception, PCOS and others. This is your own logged '\n'data next to a published range. It is a reason to ask a clinician, '\n'not an answer from one.'", "sha256": "94d170159d77c66945e0223c35db8e3563c2edb5273fbd5f1776a0006962dee7", "kind": "dart", "start": 51722, "end": 52005, "line": 1354}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-52321", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-52321", "text": "'Hide cycle lengths'", "sha256": "13d49d99c04e66a9310ee628aca9ddbdb100a6099c29b03475b9ced492c9c1c1", "kind": "dart", "start": 52321, "end": 52341, "line": 1366}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-54074", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-54074", "text": "'Resting heart rate'", "sha256": "8109f61a2ba69dd70f43fd8f6773ad54824d10b44e2393208cecbcb21003e97d", "kind": "dart", "start": 54074, "end": 54094, "line": 1408}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-54393", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-54393", "text": "'Descriptive only.'", "sha256": "547f14dfc686eb6d2f14713fa421d739ef333133d4d7d9d3a74e8a147e44dd8a", "kind": "dart", "start": 54393, "end": 54412, "line": 1418}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-54553", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-54553", "text": "'Not enough derived nights this cycle yet'", "sha256": "4e4017183bed195d228556a8bf87c264a5781805bbfcffaa7f654cc742b7a9d0", "kind": "dart", "start": 54553, "end": 54595, "line": 1423}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-56106", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-56106", "text": "' Every day drawn here is inside your own night-to-night spread: the '\n'biggest gap between two of them is $s, and $n is the smallest '\n'change this can tell from noise. A shape, not a shift.'", "sha256": "986989e7d081574a4c06c8477f015e4d76e138c6f11578161563de2d73df4ef2", "kind": "dart", "start": 56106, "end": 56330, "line": 1465}
{"id": "lib/ui2/screens/cycle_screen.dart:offset-56384", "file": "lib/ui2/screens/cycle_screen.dart", "location": "offset-56384", "text": "' Your nights vary by $n on their own, so days closer together than '\n'that are not separated. The biggest gap here is $s.'", "sha256": "2bfa3ca132c4858728765332a1221ed5556d0bb03ae1ddee591bac374516dfdb", "kind": "dart", "start": 56384, "end": 56523, "line": 1469}
