{"id": "lib/ui2/screens/day_timeline.dart:offset-34103", "file": "lib/ui2/screens/day_timeline.dart", "location": "offset-34103", "text": "'Nothing was recorded on this day'", "sha256": "90f325dce5589520613698d7225aa1854eaffb6315108d371dbcfc0abf96a563", "kind": "dart", "start": 34103, "end": 34137, "line": 924}
