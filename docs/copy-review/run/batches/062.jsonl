{"id": "lib/ui2/screens/ai_briefing.dart:offset-3825", "file": "lib/ui2/screens/ai_briefing.dart", "location": "offset-3825", "text": "'Nothing written for today'", "sha256": "e8b737164bb8451c0eabbcc45eef1d2ae19931c7522399109ec6e7d9c149a299", "kind": "dart", "start": 3825, "end": 3852, "line": 111}
{"id": "lib/ui2/screens/ai_briefing.dart:offset-3930", "file": "lib/ui2/screens/ai_briefing.dart", "location": "offset-3930", "text": "'Briefings are generated on a schedule, or on demand '\n'here.'", "sha256": "4c57db23bf3748ca78ce20f4551343af1bf6db647f790456e0a7ca51a371f512", "kind": "dart", "start": 3930, "end": 4022, "line": 113}
{"id": "lib/ui2/screens/ai_briefing.dart:offset-4176", "file": "lib/ui2/screens/ai_briefing.dart", "location": "offset-4176", "text": "'Write one now'", "sha256": "595ac53d787e69e6abdfb771b68bab51395058c8128d7ca8f5dd1d7c8cf0de33", "kind": "dart", "start": 4176, "end": 4191, "line": 117}
{"id": "lib/ui2/screens/ai_briefing.dart:offset-5340", "file": "lib/ui2/screens/ai_briefing.dart", "location": "offset-5340", "text": "'Write it again'", "sha256": "6f77dcbd7ca70d358191cffd3389e363bcfea4659ef26207bfc313fa5980d1fb", "kind": "dart", "start": 5340, "end": 5356, "line": 144}
{"id": "lib/ui2/screens/ai_briefing.dart:offset-5761", "file": "lib/ui2/screens/ai_briefing.dart", "location": "offset-5761", "text": "'That did not go through'", "sha256": "283d61d4d7e01cc618705b71a8bcf70308dcd287ba372f125b617ee8b276c69d", "kind": "dart", "start": 5761, "end": 5786, "line": 154}
{"id": "lib/ui2/screens/ai_briefing.dart:offset-8347", "file": "lib/ui2/screens/ai_briefing.dart", "location": "offset-8347", "text": "'What was sent'", "sha256": "0f70c016504d5c8b8bdba4f7b29155b2a38c38b21740f5e9e6743c2208fe6962", "kind": "dart", "start": 8347, "end": 8362, "line": 227}
