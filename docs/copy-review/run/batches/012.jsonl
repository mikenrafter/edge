{"id": "lib/l10n/app_en.arb:cycleLegendPublishedRange", "file": "lib/l10n/app_en.arb", "location": "cycleLegendPublishedRange", "text": "Published range", "sha256": "b870a354374d12256af0e40f3f4c4edf3cd701e4ff8819a2b37c9bb89f475f5f", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:cycleTwoLinesFootnote", "file": "lib/l10n/app_en.arb", "location": "cycleTwoLinesFootnote", "text": "The two lines are {low} and {high} days.", "sha256": "2115922b8a066be296f2737a58ef38fe923ab84a49aa87c196ff3d4cbb1f4a71", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:cycleLengthChangesReasons", "file": "lib/l10n/app_en.arb", "location": "cycleLengthChangesReasons", "text": "Cycle length changes for many reasons — thyroid, stress, weight change, contraception, PCOS and others. This is your own logged data next to a published range. It is a reason to ask a clinician, not an answer from one.", "sha256": "7f4a78f9b2f7f3142e7ea2a48557866b3a1e07ffb53ddf1409f2785bdb350f1c", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:cycleHideLengths", "file": "lib/l10n/app_en.arb", "location": "cycleHideLengths", "text": "Hide cycle lengths", "sha256": "e2f2748ff33b2a76560f57efd0d0a0c29c4d1630eb556313ab12eda1d52315c2", "kind": "arb"}
