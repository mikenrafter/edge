{"id": "lib/ui2/screens/investigate.dart:offset-40862", "file": "lib/ui2/screens/investigate.dart", "location": "offset-40862", "text": "'Cycle length, quartiles'", "sha256": "48e0d9637412d7a55db0617b96992c8c24505c8c92bf2231f4960785a573be71", "kind": "dart", "start": 40862, "end": 40887, "line": 894}
