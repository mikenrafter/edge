{"id": "lib/l10n/app_en.arb:bandNotifOneBuzzTitle", "file": "lib/l10n/app_en.arb", "location": "bandNotifOneBuzzTitle", "text": "One buzz, not a stream", "sha256": "3cc2de7bc9cb507062a747747caee30b380dc37264811866c763ecc606ccef33", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:bandNotifOneBuzzBody", "file": "lib/l10n/app_en.arb", "location": "bandNotifOneBuzzBody", "text": "Repeat posts from the same app are ignored for four seconds, ongoing notifications (media players, downloads) never buzz, and nothing buzzes at all while the band is disconnected.", "sha256": "f3eb20d9aec68e6177d7c8ba81abf2185b6cfbabe45919fc8f9370f345f30057", "kind": "arb"}
