{"id": "lib/l10n/app_en.arb:investigateNeedsSeveralNights", "file": "lib/l10n/app_en.arb", "location": "investigateNeedsSeveralNights", "text": "This needs several nights with a few observed hours each.", "sha256": "0d448c9fa72a9d6a31c982af59cba2a91acdbe1db62b86cdf51e0e799e87a444", "kind": "arb"}
