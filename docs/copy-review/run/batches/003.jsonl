{"id": "lib/l10n/app_en.arb:welcomeSummariesDidNotTitle", "file": "lib/l10n/app_en.arb", "location": "welcomeSummariesDidNotTitle", "text": "The days landed, the summaries did not", "sha256": "d40b2ed1c86e6a26218198db7f6ad6b50cf03d29f1ed5b891f297ddf9de2294d", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:welcomeSummariesDidNotBody", "file": "lib/l10n/app_en.arb", "location": "welcomeSummariesDidNotBody", "text": "Every imported row is in the database, but rebuilding the cross-day summaries over them threw ({error}), so trends and insights still describe the data you had before. Re-analyze everything from Your data rebuilds them.", "sha256": "59c6d5098ff4b451e54182a4f0037b092f82a4672252575fa224766074f0b7aa", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:welcomePartOfFileNotUsedTitle", "file": "lib/l10n/app_en.arb", "location": "welcomePartOfFileNotUsedTitle", "text": "Part of that file could not be used", "sha256": "7af75956f9a2fc0c4bf712a6e9de39a66f6178617b52a386e72c3e3a98c5010f", "kind": "arb"}
