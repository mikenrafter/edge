{"id": "lib/l10n/app_en.arb:welcomePassphraseTooShort", "file": "lib/l10n/app_en.arb", "location": "welcomePassphraseTooShort", "text": "At least {n} characters.", "sha256": "29a543a4eca110f3436ab5252164ef5d708887b154c4d9e5b6a319a6be6e9558", "kind": "arb"}
{"id": "lib/l10n/app_en.arb:welcomePassphraseMismatch", "file": "lib/l10n/app_en.arb", "location": "welcomePassphraseMismatch", "text": "The two do not match.", "sha256": "184006b7bab81ed6cf20c6d0d3532308680031c82ca819ecde5470f914735df7", "kind": "arb"}
