{"id": "lib/l10n/app_en.arb:welcomeSubhead", "file": "lib/l10n/app_en.arb", "location": "welcomeSubhead", "text": "Every number is computed on this phone from the raw signal.", "sha256": "da766d0dceb55b016eb28133872abb3e304ac9ec257d89ee39bcfa4676946b12", "kind": "arb"}
