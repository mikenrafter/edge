  "ecgScreenerSinusMeaning": "बैंड ने 51 से 99 धड़कन प्रति मिनट की हृदय गति पर नियमित लय बताई। ऐप ने इस रिकॉर्डिंग की गुणवत्ता नहीं जाँची है। इसका अर्थ यह नहीं कि आपको निश्चिंत घोषित कर दिया गया: यह स्क्रीनिंग कुछ भी खारिज नहीं कर सकती और केवल एक छोटी रिकॉर्डिंग देखती है।",
  "ecgScreenerLowHrMeaning": "औसत हृदय गति 50 धड़कन प्रति मिनट या उससे कम थी। कुछ लोगों में कम गति आम हो सकती है, और यह स्क्रीनिंग कारण के बारे में कुछ नहीं बताती। यदि आपको चक्कर आए, बेहोशी जैसा लगे या तबीयत ठीक न लगे, तो चिकित्सक से मिलें।",
  "ecgScreenerPossibleAfibMeaning": "बैंड की स्क्रीनिंग ने इस रिकॉर्डिंग में 51 से 99 धड़कन प्रति मिनट की हृदय गति पर अनियमित लय चिह्नित की। चिह्न एक उचित जाँच का संकेत है, निष्कर्ष नहीं। कलाई के बैंड की एक छोटी रिकॉर्डिंग स्थायी पैटर्न और क्षणिक पैटर्न में अंतर नहीं कर सकती, इसलिए ईसीजी के लिए चिकित्सक से मिलें, खासकर लक्षण होने पर।",
  "ecgScreenerAfibHighHrMeaning": "बैंड की स्क्रीनिंग ने 100 से 150 धड़कन प्रति मिनट की हृदय गति के साथ अनियमित लय चिह्नित की। चिह्न एक उचित जाँच का संकेत है, निष्कर्ष नहीं। ईसीजी के लिए चिकित्सक से मिलें, और तबीयत ठीक न लगने, साँस फूलने या सीने में दर्द होने पर जल्दी मिलें।",
  "ecgScreenerHighHrMeaning": "हृदय गति 151 से 200 धड़कन प्रति मिनट के बीच थी। इस गति पर स्क्रीनिंग नियमित और अनियमित लय में अंतर नहीं कर पाती। व्यायाम, बुखार, कैफ़ीन और तनाव इसे बढ़ाते हैं। यदि आराम में भी यह ऊँची रहे या तबीयत ठीक न लगे, तो चिकित्सक से मिलें।",
  "ecgScreenerHighHrNoAfibMeaning": "हृदय गति 100 से 150 धड़कन प्रति मिनट के बीच थी और स्क्रीनिंग ने कोई अनियमित लय चिह्नित नहीं की। इसका अर्थ यह नहीं कि आपको निश्चिंत घोषित कर दिया गया: यह स्क्रीनिंग कुछ भी खारिज नहीं कर सकती। यदि आराम में भी ऊँची गति बनी रहे या तबीयत ठीक न लगे, तो चिकित्सक से मिलें।",
  "ecgScreenerInconclusiveMeaning": "बैंड इस रिकॉर्डिंग से कोई परिणाम नहीं निकाल सका; संभव है सिग्नल में बहुत शोर था या वह बहुत छोटा था। यह किसी भी दिशा में कुछ नहीं बताता। हाथ को आराम से रखकर और उँगलियाँ स्थिर रखकर फिर कोशिश करें। यह प्रयास रीडिंग के विवरण में रखा जाता है, और 10 मिनट के भीतर शुरू की गई रीडिंग इसके साथ समूहित हो जाती है।",
  "ecgScreenerUnreadableMeaning": "ऐप इस रिकॉर्डिंग से लय नहीं पढ़ सका: बैंड ने कम आयाम, शोर, अस्थिर सिग्नल या अपर्याप्त डेटा बताया, या उसके परिणाम कोड अथवा हृदय गति को किसी परिणाम से जोड़ा नहीं जा सका। इस रिकॉर्डिंग की स्क्रीनिंग नहीं हुई। स्क्रीनिंग न होना और कुछ भी चिह्नित न होना एक बात नहीं है।",
  "ecgScreenerPartialMeaning": "रिकॉर्डिंग पूरी होने से पहले रुक गई, क्योंकि ऐप बैकग्राउंड में चला गया, समय समाप्त हो गया या बैंड का कनेक्शन टूट गया। जो रिकॉर्ड हुआ वह आंशिक रीडिंग के रूप में सहेजा गया है। इसकी स्क्रीनिंग नहीं हुई, इसलिए कोई लय परिणाम नहीं दिया जाता। हृदय गति और सिग्नल गुणवत्ता तभी दिखती है जब कम से कम 10 सेकंड का सिग्नल रिकॉर्ड हुआ हो।",
  "ecgScreenerFailedMeaning": "रीडिंग पूरी नहीं हो सकी: बैंड ने उसे शुरू नहीं किया, या कोई सिग्नल आने से पहले कनेक्शन टूट गया। इसकी स्क्रीनिंग नहीं हुई और कुछ भी सहेजा नहीं गया। जाँचें कि बैंड कनेक्टेड है और कसकर पहना है, फिर दोबारा कोशिश करें।",
  "ecgScreenerIntro": "यह एक स्क्रीनिंग है, चिकित्सा जाँच नहीं।\n\nकुछ भी चिह्नित न होने वाला परिणाम यह नहीं बताता कि आपको निश्चिंत घोषित कर दिया गया, और यह स्क्रीनिंग कुछ भी खारिज नहीं कर सकती। जिस परिणाम की स्क्रीनिंग नहीं हुई, वह कुछ नहीं कहता।\n\nपरिणाम बैंड का अपना है। ऐप खुद ट्रेस नहीं पढ़ता और उसने रिकॉर्डिंग की गुणवत्ता नहीं जाँची है; बैंड कोई समस्या बताए तभी वह लय परिणाम रोकता है। कलाई का बैंड केवल एक लीड रिकॉर्ड करता है।\n\nलक्षण होने पर उचित जाँच के लिए चिकित्सक से मिलें।",
