// FIXTURE: override_bad_base_call_outside_heavy
import 'dart:isolate';
import 'package:openstrap_analytics/onehz.dart';
import 'package:openstrap_edge/util/heavy.dart';
import 'package:openstrap_edge/util/worker_entries.dart';
import 'package:openstrap_edge/util/worker_init.dart';

@sendable
class DayArgs {
  final int nowEpochMs;
  final List<double> hr;
  const DayArgs(this.nowEpochMs, this.hr);
}

@sendable
class DayOut {
  final double? readiness;
  const DayOut(this.readiness);
}
const kWorkerEntries = <WorkerEntry>[
  WorkerEntry(#runStagerHeavy, dispatcher: Dispatcher.run, reason: 'fixture'),
];

abstract class Stager {
  // Unmarked on purpose: one override is @heavy, so the base counts as heavy.
  DayOut stageHeavy(DayArgs a);
}

class CardioStager extends Stager {
  @override
  @heavy
  DayOut stageHeavy(DayArgs a) {
    assertWorker();
    return DayOut(readinessCompute(a.hr).value);
  }
}

@heavy
DayOut runStagerHeavy(DayArgs a) {
  assertWorker();
  return CardioStager().stageHeavy(a);
}

class Screen {
  DayOut now(Stager s, DayArgs a) => s.stageHeavy(a);
}
class Caller {
  Future<DayOut> via_runStagerHeavy_call(int n, List<double> hr) => Isolate.run(() {
    final a = DayArgs(n, hr);
    return runStagerHeavy(a);
  });
}
