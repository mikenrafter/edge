// FIXTURE: rawreader_bad_unregistered
import 'package:openstrap_edge/util/raw_readers.dart';

typedef Row = Map<String, Object?>;

class Database {
  Future<List<Row>> query(String table) async => const [];
  Future<List<Row>> rawQuery(String sql) async => const [];
}

class LocalDb {
  LocalDb(this._db);
  final Database _db;

  Future<RowBatch<Row>> getOnehz() async => RowBatch.wrap(await _db.query('decoded_onehz'));
}
