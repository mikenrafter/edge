// FIXTURE: c_bad_inner_also_dispatched
import 'dart:isolate';
import 'package:openstrap_analytics/onehz.dart';
import 'package:openstrap_edge/util/heavy.dart';
import 'package:openstrap_edge/util/worker_entries.dart';
import 'package:openstrap_edge/util/worker_init.dart';

@sendable
class DayArgs {
  final int nowEpochMs;
  final List<double> hr;
  const DayArgs(this.nowEpochMs, this.hr);
}

@sendable
class DayOut {
  final double? readiness;
  const DayOut(this.readiness);
}
const kWorkerEntries = <WorkerEntry>[
  WorkerEntry(#deriveDayHeavy, dispatcher: Dispatcher.run, reason: 'fixture'),
];

@heavy
DayOut deriveDayHeavy(DayArgs a) {
  assertWorker();
  return innerHeavy(a);
}

// Called by a heavy function AND handed straight to a dispatcher: that second
// path makes it a root, and roots must be registered.
@heavy
DayOut innerHeavy(DayArgs a) {
  assertWorker();
  return DayOut(readinessCompute(a.hr).value);
}

class Caller {
  Future<DayOut> go(int n, List<double> hr) => Isolate.run(() {
        final a = DayArgs(n, hr);
        return deriveDayHeavy(a);
      });

  Future<DayOut> sneak(int n, List<double> hr) => Isolate.run(() {
        final a = DayArgs(n, hr);
        return innerHeavy(a);
      });
}
