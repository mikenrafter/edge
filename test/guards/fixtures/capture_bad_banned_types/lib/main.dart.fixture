// FIXTURE: capture_bad_banned_types
import 'dart:async';
import 'dart:isolate';
import 'package:openstrap_analytics/onehz.dart';
import 'package:openstrap_edge/util/heavy.dart';
import 'package:openstrap_edge/util/worker_entries.dart';
import 'package:openstrap_edge/util/worker_init.dart';

@sendable
class DayArgs {
  final int nowEpochMs;
  final List<double> hr;
  const DayArgs(this.nowEpochMs, this.hr);
}

@sendable
class DayOut {
  final double? readiness;
  const DayOut(this.readiness);
}

const kWorkerEntries = <WorkerEntry>[
  WorkerEntry(#deriveHeavy, dispatcher: Dispatcher.run, reason: 'fixture'),
];


@heavy
DayOut deriveHeavy(DayArgs a) {
  assertWorker();
  return DayOut(readinessCompute(a.hr).value);
}


class BuildContext {}

class LocalDb {}

class MethodChannel {}

class Leaky {
  Future<DayOut> go(BuildContext ctx, StreamSubscription<int> sub, LocalDb db,
      MethodChannel ch) {
    return Isolate.run(() {
      final n = ctx.hashCode + sub.hashCode + db.hashCode + ch.hashCode;
      return deriveHeavy(DayArgs(n, const []));
    });
  }
}
