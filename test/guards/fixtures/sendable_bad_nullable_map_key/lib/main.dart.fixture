@sendable
class DayArgs {
  final int nowEpochMs;
  final List<double> hr;
  const DayArgs(this.nowEpochMs, this.hr);
}

@sendable
class DayOut {
  final double? readiness;
  const DayOut(this.readiness);
}
const kWorkerEntries = <WorkerEntry>[
  WorkerEntry(#keyHeavy, dispatcher: Dispatcher.run, reason: 'fixture'),
];

@heavy
double keyHeavy(Map<String?, int> m) {
  assertWorker();
  return m.length.toDouble();
}

class Caller {
  Future<double> go() => Isolate.run(() => keyHeavy(const {}));
}
