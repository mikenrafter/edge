// FIXTURE: rawreader_bad_exposes_rows_variants


typedef Row = Map<String, Object?>;

class Database {
  Future<List<Row>> query(String table) async => const [];
  Future<List<Row>> rawQuery(String sql) async => const [];
}

class LocalDb {
  LocalDb(this._db);
  final Database _db;

  Future<List<Row>> beats() => _db.query('decoded_rr');

  // A Map whose VALUES are row collections exposes rows too.
  Future<Map<String, List<Row>>> byDay() async => {
        'd': await _db.query('decoded_onehz'),
      };

  Stream<Row> stream() async* {
    yield* Stream.fromIterable(await _db.query('raw_records'));
  }
}
