// WHY: trace concrete callback sources; unknown and heavy work remain findings.
// CLAIM(resolved-effects); catches: blanket callback exemptions.
abstract interface class Work<T> { T run(); }
final class InlineWork<T> implements Work<T> {
  InlineWork(this.body); final T Function() body;
  @override T run() => body();
}
void run(int Function() external) { InlineWork(external).run(); }
